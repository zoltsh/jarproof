#!/bin/sh
set -eu

if [ "${JARPROOF_MANAGED_TOOLCHAIN:-}" != "1" ]; then
    exec zolt exec -- env JARPROOF_MANAGED_TOOLCHAIN=1 scripts/check
fi

zolt resolve --workspace --locked
zolt test --workspace --members modules/jarproof-api,modules/jarproof-engine,apps/jarproof,guardrails/jarproof-architecture-tests
zolt coverage --workspace --members modules/jarproof-api,modules/jarproof-engine,apps/jarproof,guardrails/jarproof-architecture-tests
zolt "-Djava.home=$JAVA_HOME" package --workspace --all
zolt integration-test --workspace --member apps/jarproof
JARPROOF_SMOKE_PREBUILT=1 scripts/smoke
zolt check --workspace --all --context ci --require-package
